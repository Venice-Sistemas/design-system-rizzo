{
  "name": "@venice-sistemas/tokens",
  "version": "0.2.0",
  "description": "Design tokens da Rizzo Park — fonte única de verdade, compartilhada por web, React Native e legado",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Venice-Sistemas/design-system-rizzo.git",
    "directory": "packages/tokens"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "default": "./dist/native.mjs"
    },
    "./contrast": {
      "types": "./src/contrast.d.ts",
      "default": "./src/contrast.mjs"
    },
    "./css": "./dist/tokens.css",
    "./tailwind": "./dist/tailwind.css",
    "./shadcn": "./dist/shadcn.css",
    "./fonts/*": "./dist/fonts/*",
    "./contrast-pairs.json": "./contrast-pairs.json",
    "./primitives.json": "./dist/primitives.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/contrast.mjs",
    "src/contrast.d.ts",
    "contrast-pairs.json"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node build.mjs && vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm test"
  },
  "devDependencies": {
    "@fontsource/poppins": "^5.1.0",
    "style-dictionary": "^4.3.0",
    "vitest": "^2.1.5"
  }
}
