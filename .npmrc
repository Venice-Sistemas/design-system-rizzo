# Levanta as dependências transitivas para o topo apenas quando necessário.
# strict-peer-dependencies=false evita travar o install por peer range de libs
# de terceiros que ainda não declararam React 19.
strict-peer-dependencies=false
auto-install-peers=true

# Registro de publicação: GitHub Packages (P-15 decidida). O escopo é
# `@venice-sistemas` porque o registro npm do GitHub exige que ele seja igual ao
# nome da org — não foi escolha de nome.
#
# O token NÃO mora aqui — este arquivo é versionado. Cada pessoa põe o dela no
# .npmrc de usuário (~/.npmrc), na linha:
#
#   //npm.pkg.github.com/:_authToken=<PAT com read:packages>
#
# Sem isso, `pnpm install` falha com 401 ao tentar ler o pacote privado.
@venice-sistemas:registry=https://npm.pkg.github.com

# O trabalho acontece em `develop`. Sem esta linha o `pnpm publish` pergunta se
# você quer mesmo publicar fora de main/master — e a pergunta trava qualquer
# execução não interativa. Declarar a branch é melhor que passar
# --no-git-checks, que desligaria junto a verificação de árvore suja.
publish-branch=develop
